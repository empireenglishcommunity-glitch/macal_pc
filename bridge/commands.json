{
  "batch_id": "startup-organize-001",
  "description": "Register startup organizer — runs when PC boots",
  "commands": [
    {
      "id": 1,
      "description": "Pull the startup script",
      "command": "git fetch origin && git checkout origin/phase-3/gui-operations -- scripts/startup_organize.bat",
      "risk": "green"
    },
    {
      "id": 2,
      "description": "Register with Task Scheduler (runs on login, after agent)",
      "command": "schtasks /create /tn \"MACAL Auto-Organize\" /tr \"C:\\Users\\97150\\macal_pc\\scripts\\startup_organize.bat\" /sc onlogon /delay 0001:00 /rl highest /f",
      "risk": "yellow"
    },
    {
      "id": 3,
      "description": "Verify both tasks are registered",
      "command": "schtasks /query /tn \"MACAL Agent\" && schtasks /query /tn \"MACAL Auto-Organize\"",
      "risk": "green"
    }
  ]
}
